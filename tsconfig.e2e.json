{
  // ملف إعداد خاص ببناء الاختبار الشامل.
  //
  // السبب: كل بناء لـ Next يولّد أنواع مسارات داخل مجلّد مخرجاته ويضيفها إلى
  // `include`. ولمّا كان الاختبار الشامل يبني في `.next-e2e` بينما خادم التطوير
  // يبني في `.next`، اجتمع مجلّدا أنواع متضاربان في ملف واحد فسقط البناء.
  // هنا نُضمّن أنواع `.next-e2e` وحدها ونستثني `.next`.
  "extends": "./tsconfig.json",
  "include": [
    "**/*.ts",
    "**/*.tsx",
    ".next-e2e/types/**/*.ts",
    "next-env.d.ts",
    ".next-probe/types/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "tests/e2e",
    ".next"
  ]
}

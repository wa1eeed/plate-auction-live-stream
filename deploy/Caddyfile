# ==============================================================
#  البديل الأبسط — Caddy
#
#  يمرّر ترقية WebSocket تلقائيًّا بلا إعداد، ويستخرج شهادة TLS ويجدّدها
#  وحده. لا شيء هنا عن /ws لأنّ `reverse_proxy` يفهمها أصلًا — وهذا سبب
#  ترجيحه على nginx في هذه الحالة تحديدًا.
#
#    sudo caddy run --config /etc/caddy/Caddyfile
# ==============================================================

staging.example.com {          # ← ضع نطاقك
    encode gzip zstd
    reverse_proxy 127.0.0.1:3000 {
        # أطول من نبضة الخادم (٣٠ ثانية) فلا يُقطع مقبسٌ صامت
        transport http {
            read_timeout 3600s
        }
    }
    request_body {
        max_size 8MB
    }
}

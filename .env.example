# ==========================================================
#  إعدادات البيئة — انسخ هذا الملف إلى .env.local
#  cp .env.example .env.local
# ==========================================================

# طبقة التخزين — التنفيذ الحالي في الذاكرة
AUCTION_STORE=memory

# تفعيل وضع Demo: يعرض بيانات تجريبية وحسابات جاهزة
# يجب ضبطه صراحةً لإظهار بطاقة الحساب التجريبي — والافتراض إطفاؤه
DEMO_MODE=true

# البيئة: `staging` وحدها تُظهر شارة «نسخة تجريبية» أعلى الصفحات.
# اتركه فارغًا في أي نشر حقيقي.
APP_ENV=

# حساب الإدارة التجريبي — **بدّله في أي نشر على الإنترنت**.
# البذرة تُنشئ الحساب دائمًا، و`DEMO_MODE` يحكم عرض بياناته لا وجوده:
# فتركُ الافتراضي على مستودع عامّ = لوحة إدارة مفتوحة لمن قرأ الكود.
# البريد يُطبَّع (تُخفَّض حروفه وتُقصّ مسافاته) فيُقبل كما تكتبه.
#   openssl rand -base64 24
DEMO_ADMIN_EMAIL=
DEMO_ADMIN_PASSWORD=

# مفتاح توقيع جلسات الكوكيز (HMAC). غيّره في الإنتاج بقيمة عشوائية طويلة:
# openssl rand -base64 48
SESSION_SECRET=change-me-with-a-long-random-string

# عنوان التطبيق العام — يُستخدم في خريطة الموقع وروابط المشاركة
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ---------------- تحديد المعدل ----------------
# يحمي المزايدة والشراء وإرسال العروض من الضغط السريع المتكرر
BID_RATE_LIMIT_WINDOW_MS=10000
BID_RATE_LIMIT_MAX=6

# ---------------- عنوان الاستماع ----------------
# يقرأهما server.mjs مباشرة
PORT=3000
HOST=0.0.0.0

# ---------------- بوابة الدفع Tap ----------------
# https://developers.tap.company  →  goSell → API Credentials
#
# المفاتيح السرّية هنا وحدها — لا تُخزَّن في قاعدة البيانات ولا تصل إلى العميل.
# الأدمن يختار من لوحة الإدارة أي بيئة تعمل، لا قيمة المفتاح.
# اترك مفتاح البيئة الحقيقية فارغًا حتى تكتمل تهيئة الحساب لدى Tap.
TAP_TEST_SECRET_KEY=
TAP_LIVE_SECRET_KEY=

# ملاحظة: عنوان الويبهوك الذي يستدعيه Tap هو
#   ${NEXT_PUBLIC_APP_URL}/api/webhooks/tap
# ويجب أن يكون بعنوان عام يصله Tap من الإنترنت.
